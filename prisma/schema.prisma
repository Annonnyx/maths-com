generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  username                 String                   @unique
  password                 String?
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  displayName              String?                  @map("display_name")
  avatarUrl                String?                  @map("avatar_url")
  classe                   String?
  birthYear                Int?                     @map("birth_year")
  bannerUrl                String?                  @map("banner_url")
  selectedBadgeIds         String?                  @map("selected_badge_ids")
  customBannerId           String?                  @map("custom_banner_id")
  isAdmin                  Boolean                  @default(false) @map("is_admin")
  isTeacher                Boolean                  @default(false) @map("is_teacher")
  school                   String?
  subject                  String?
  acceptJoinRequests       Boolean                  @default(true) @map("accept_join_requests")
  soloElo                  Int                      @default(400) @map("solo_elo")
  soloRankClass            String                   @default("F-") @map("solo_rank_class")
  soloBestElo              Int                      @default(400) @map("solo_best_elo")
  soloBestRankClass        String                   @default("F-") @map("solo_best_rank_class")
  multiplayerElo           Int                      @default(400) @map("multiplayer_elo")
  multiplayerRankClass     String                   @default("F-") @map("multiplayer_rank_class")
  multiplayerBestElo       Int                      @default(400) @map("multiplayer_best_elo")
  multiplayerBestRankClass String                   @default("F-") @map("multiplayer_best_rank_class")
  soloCurrentStreak        Int                      @default(0) @map("solo_current_streak")
  soloBestStreak           Int                      @default(0) @map("solo_best_streak")
  lastTestDate             DateTime?                @map("last_test_date")
  isOnline                 Boolean                  @default(false) @map("is_online")
  lastSeenAt               DateTime                 @default(now()) @map("last_seen_at")
  discordId                String?                  @unique @map("discord_id")
  discordUsername          String?                  @map("discord_username")
  discordLinkedAt          DateTime?                @map("discord_linked_at")
  discordLinkCode          String?                  @unique @map("discord_link_code")
  hasCompletedOnboarding   Boolean                  @default(false) @map("has_completed_onboarding")
  QuestionHistory          public_QuestionHistory[]
  assignmentSubmissions    AssignmentSubmission[]
  receivedChallenges       Challenge[]              @relation("Challenged")
  sentChallenges           Challenge[]              @relation("Challenger")
  groupMemberships         ClassGroupMember[]
  taughtGroups             ClassGroup[]             @relation("GroupTeacher")
  receivedJoinRequests     ClassJoinRequest[]       @relation("StudentJoinRequests")
  sentJoinRequests         ClassJoinRequest[]       @relation("TeacherJoinRequests")
  groupMessages            ClassMessage[]
  coursePracticeHistories  CoursePracticeHistory[]
  createdBanners           CustomBanner[]           @relation("BannerCreator")
  exerciseAttempts         ExerciseAttempt[]
  sentFriendships          Friendship[]             @relation("User1")
  receivedFriendships      Friendship[]             @relation("User2")
  gamePlayerships          GamePlayer[]             @relation("GamePlayerships")
  hostedSessions           GameSession[]            @relation("HostedSessions")
  receivedMessages         Message[]                @relation("ReceivedMessages")
  sentMessages             Message[]                @relation("SentMessages")
  player1Games             MultiplayerGame[]        @relation("Player1Games")
  player2Games             MultiplayerGame[]        @relation("Player2Games")
  multiplayerStatistics    MultiplayerStatistics?
  sentNotifications        Notification[]           @relation("NotificationSender")
  notifications            Notification[]
  questionHistory          QuestionHistory[]
  soloStatistics           SoloStatistics?
  soloTests                SoloTest[]
  teacherRequests          TeacherRequest[]
  userBadges               UserBadge[]
  customBanners            CustomBanner[]           @relation("UserBanners")
  cliApiKeys               CliApiKey[]

  @@map("users")
  @@schema("public")
}

model SoloStatistics {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  totalTests            Int      @default(0)
  totalQuestions        Int      @default(0)
  totalCorrect          Int      @default(0)
  totalTime             Int      @default(0)
  averageScore          Float    @default(0)
  averageTime           Float    @default(0)
  additionTests         Int      @default(0)
  additionCorrect       Int      @default(0)
  additionTotal         Int      @default(0)
  subtractionTests      Int      @default(0)
  subtractionCorrect    Int      @default(0)
  subtractionTotal      Int      @default(0)
  multiplicationTests   Int      @default(0)
  multiplicationCorrect Int      @default(0)
  multiplicationTotal   Int      @default(0)
  divisionTests         Int      @default(0)
  divisionCorrect       Int      @default(0)
  divisionTotal         Int      @default(0)
  powerTests            Int      @default(0)
  powerCorrect          Int      @default(0)
  powerTotal            Int      @default(0)
  rootTests             Int      @default(0)
  rootCorrect           Int      @default(0)
  rootTotal             Int      @default(0)
  factorizationTests    Int      @default(0)
  factorizationCorrect  Int      @default(0)
  factorizationTotal    Int      @default(0)
  weakPoints            String?
  eloHistory            String?
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("solo_statistics")
  @@schema("public")
}

model SoloTest {
  id             String         @id @default(cuid()) @map("id")
  userId         String         @map("user_id")
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  totalQuestions Int            @default(20)
  correctAnswers Int            @default(0)
  score          Int
  timeTaken      Int
  eloBefore      Int
  eloAfter       Int
  eloChange      Int
  timeBonus      Int            @default(0)
  isPerfect      Boolean        @default(false)
  isStreakTest   Boolean        @default(false)
  questions      SoloQuestion[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("solo_tests")
  @@schema("public")
}

model SoloQuestion {
  id          String   @id @default(cuid()) @map("id")
  testId      String   @map("test_id")
  type        String
  difficulty  Int
  question    String
  answer      String
  userAnswer  String?
  isCorrect   Boolean?
  timeTaken   Int?
  explanation String?
  order       Int
  test        SoloTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@map("solo_questions")
  @@schema("public")
}

model GameSession {
  id                   String           @id @default(cuid()) @map("id")
  code                 String           @unique @db.VarChar(6)
  hostId               String           @map("host_id")
  status               String           @default("waiting")
  quizId               String?
  maxPlayers           Int              @default(20)
  currentQuestionIndex Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  players              GamePlayer[]
  host                 User             @relation("HostedSessions", fields: [hostId], references: [id])
  gameQuestions      GameQuestion[]

  @@map("game_sessions")
  @@schema("public")
}

model GamePlayer {
  id        String      @id @default(cuid()) @map("id")
  sessionId String      @map("session_id")
  userId    String      @map("user_id")
  score     Int         @default(0)
  joinedAt  DateTime    @default(now())
  isReady   Boolean     @default(false)
  updatedAt DateTime    @updatedAt
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation("GamePlayerships", fields: [userId], references: [id], onDelete: Cascade)

  @@map("game_players")
  @@schema("public")
}

model GameQuestion {
  id         String      @id @default(cuid()) @map("id")
  sessionId  String      @map("session_id")
  question   String
  answer     String
  type       String
  difficulty Int
  order      Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  session    GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("game_questions")
  @@schema("public")
}

model ExerciseAttempt {
  id            String   @id @default(cuid()) @map("id")
  userId        String   @map("user_id")
  type          String
  difficulty    Int
  question      String
  answer        String
  userAnswer    String
  isCorrect     Boolean
  timeTaken     Int
  feedbackShown Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exercise_attempts")
  @@schema("public")
}

model Course {
  id                String                  @id @default(cuid()) @map("id")
  title             String
  slug              String                  @unique
  description       String
  content           String
  difficulty        Int
  order             Int
  isPublished       Boolean                 @default(true)
  relatedTypes      String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  practiceHistories CoursePracticeHistory[]

  @@map("courses")
  @@schema("public")
}

model Friendship {
  id        String   @id @default(cuid()) @map("id")
  user1Id   String   @map("user1_id")
  user2Id   String   @map("user2_id")
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user1     User     @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@map("friendships")
  @@schema("public")
}

model Message {
  id         String   @id @default(cuid()) @map("id")
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  type       String
  read       Boolean  @default(false)
  metadata   String?
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
  @@schema("public")
}

model MultiplayerGame {
  id            String                @id @default(cuid()) @map("id")
  player1Id     String                @map("player1_id")
  player2Id     String?
  status        String
  gameType      String
  timeControl   String
  timeLimit     Int
  player1Elo    Int
  player2Elo    Int?
  player1Score  Int                   @default(0)
  player2Score  Int                   @default(0)
  winner        String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime              @default(now())
  questionCount Int                   @default(20)
  difficulty    String                @default("mixed")
  player1       User                  @relation("Player1Games", fields: [player1Id], references: [id], onDelete: Cascade)
  player2       User?                 @relation("Player2Games", fields: [player2Id], references: [id], onDelete: Cascade)
  questions     MultiplayerQuestion[]

  @@map("multiplayer_games")
  @@schema("public")
}

model MultiplayerQuestion {
  id             String          @id @default(cuid()) @map("id")
  gameId         String          @map("game_id")
  question       String
  answer         String
  type           String
  difficulty     Int
  order          Int
  player1Answer  String?
  player2Answer  String?
  player1Time    Int?
  player2Time    Int?
  player1Correct Boolean?
  player2Correct Boolean?
  game           MultiplayerGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("multiplayer_questions")
  @@schema("public")
}

model MultiplayerStatistics {
  id                       String   @id @default(cuid()) @map("id")
  userId                   String   @unique @map("user_id")
  totalGames               Int      @default(0)
  totalWins                Int      @default(0)
  totalLosses              Int      @default(0)
  totalDraws               Int      @default(0)
  lightningGames           Int      @default(0)
  lightningWins            Int      @default(0)
  blitzGames               Int      @default(0)
  blitzWins                Int      @default(0)
  rapidGames               Int      @default(0)
  rapidWins                Int      @default(0)
  classicalGames           Int      @default(0)
  classicalWins            Int      @default(0)
  thinkingGames            Int      @default(0)
  thinkingWins             Int      @default(0)
  averageScore             Float    @default(0)
  averageTime              Float    @default(0)
  multiplayerCurrentStreak Int      @default(0)
  multiplayerBestStreak    Int      @default(0)
  headToHead               String?
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("multiplayer_statistics")
  @@schema("public")
}

model Challenge {
  id            String    @id @default(cuid()) @map("id")
  challengerId  String    @map("challenger_id")
  challengedId  String    @map("challenged_id")
  gameType      String    @default("pending")
  timeControl   String
  timeLimit     Int
  questionCount Int       @default(20)
  difficulty    String    @default("mixed")
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  challenged    User      @relation("Challenged", fields: [challengedId], references: [id])
  challenger    User      @relation("Challenger", fields: [challengerId], references: [id])

  @@map("challenges")
  @@schema("public")
}

model CustomBanner {
  id           String   @id @default(cuid()) @map("id")
  name         String
  description  String?
  imageUrl     String
  thumbnailUrl String?
  isPremium    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  creator      User     @relation("BannerCreator", fields: [createdBy], references: [id])
  users        User[]   @relation("UserBanners")

  @@map("custom_banners")
  @@schema("public")
}

model Badge {
  id           String      @id @default(cuid())
  name         String      @unique
  description  String
  icon         String
  category     String
  createdAt    DateTime    @default(now())
  rarity       String      @default("common")
  condition    String?
  isHidden     Boolean     @default(false) @map("is_hidden")
  requirements String?     @map("requirements")
  updatedAt    DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  userBadges   UserBadge[]

  @@index([category])
  @@index([category], map: "idx_badges_category")
  @@map("badges")
  @@schema("public")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now())
  isNew    Boolean  @default(true) @map("is_new")
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([badgeId], map: "idx_user_badges_badge_id")
  @@index([userId], map: "idx_user_badges_user_id")
  @@index([badgeId])
  @@index([userId])
  @@map("user_badges")
  @@schema("public")
}

model TeacherRequest {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  name      String
  email     String
  school    String
  subject   String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("teacher_requests")
  @@schema("public")
}

model FaqSubmission {
  id          String   @id @default(cuid()) @map("id")
  type        String
  title       String
  description String
  email       String?
  category    String
  status      String   @default("pending")
  userAgent   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@map("faq_submissions")
  @@schema("public")
}

model ClassGroup {
  id          String             @id @default(cuid()) @map("id")
  name        String
  teacherId   String             @map("teacher_id")
  description String?
  isPrivate   Boolean            @default(false)
  inviteCode  String?            @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  level       String?            @map("level") @db.VarChar(50)
  subject     String?            @default("maths") @map("subject") @db.VarChar(50)
  maxStudents Int?               @default(30) @map("maxstudents")
  assignments ClassAssignment[]
  members     ClassGroupMember[]
  teacher     User               @relation("GroupTeacher", fields: [teacherId], references: [id])
  messages    ClassMessage[]

  @@map("class_groups")
  @@schema("public")
}

model ClassGroupMember {
  id       String     @id @default(cuid()) @map("id")
  groupId  String     @map("group_id")
  userId   String     @map("user_id")
  role     String     @default("student")
  joinedAt DateTime   @default(now())
  group    ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("class_group_members")
  @@schema("public")
}

model ClassMessage {
  id                   String     @id @default(cuid()) @map("id")
  groupId              String     @map("group_id")
  userId               String     @map("user_id")
  content              String
  type                 String     @default("text")
  createdAt            DateTime   @default(now())
  readBy               String?    @map("read_by")
  requiresConfirmation Boolean    @default(false) @map("requires_confirmation")
  confirmedBy          String?    @map("confirmed_by")
  attachments          String?    @map("attachments")
  isPinned             Boolean    @default(false) @map("is_pinned")
  pinnedAt             DateTime?  @map("pinned_at")
  pinnedBy             String?    @map("pinned_by")
  updatedAt            DateTime?  @default(now()) @updatedAt @db.Timestamp(6)
  group                ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("class_messages")
  @@schema("public")
}

model QuestionHistory {
  id          String   @id @default(cuid()) @map("id")
  userId      String   @map("user_id")
  questionId  String   @map("question_id")
  answeredAt  DateTime @default(now())
  correct     Boolean
  eloAtMoment Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("question_history")
  @@schema("public")
}

model ClassJoinRequest {
  id        String   @id @default(cuid())
  studentId String
  teacherId String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   User     @relation("StudentJoinRequests", fields: [studentId], references: [id], onDelete: Cascade)
  teacher   User     @relation("TeacherJoinRequests", fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("class_join_requests")
  @@schema("public")
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  type            String
  title           String
  message         String
  senderId        String?
  senderName      String?
  senderAvatarUrl String?
  metadata        Json?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sender          User?    @relation("NotificationSender", fields: [senderId], references: [id])
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@schema("public")
}

model CoursePracticeHistory {
  id               String   @id @default(cuid())
  userId           String
  courseId         String
  score            Int
  questionsCount   Int
  correctAnswers   Int
  timeSpentSeconds Int
  difficultyLevel  Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("course_practice_history")
  @@schema("public")
}

model ClassAssignment {
  id             String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  classId        String                 @map("class_id")
  title          String
  description    String?
  questionCount  Int?                   @default(10) @map("question_count")
  difficulty     String?                @default("mixed")
  timeLimit      Int?                   @map("time_limit")
  operationTypes String?                @map("operation_types")
  dueDate        DateTime?              @map("due_date") @db.Timestamptz(6)
  status         String?                @default("active")
  createdAt      DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  questions      AssignmentQuestion[]
  submissions    AssignmentSubmission[]
  class          ClassGroup             @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([classId], map: "idx_class_assignments_class_id")
  @@index([status], map: "idx_class_assignments_status")
  @@map("class_assignments")
  @@schema("public")
}

model AssignmentQuestion {
  id           String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  assignmentId String             @map("assignment_id")
  question     String
  answer       String
  type         String
  difficulty   Int
  order        Int
  answers      AssignmentAnswer[]
  assignment   ClassAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assignmentId], map: "idx_assignment_questions_assignment_id")
  @@map("assignment_questions")
  @@schema("public")
}

model AssignmentSubmission {
  id            String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  assignmentId  String             @map("assignment_id")
  studentId     String             @map("student_id")
  status        String?            @default("in_progress")
  score         Int?
  correctCount  Int?               @default(0) @map("correct_count")
  totalAnswered Int?               @default(0) @map("total_answered")
  timeSpent     Int?               @map("time_spent")
  startedAt     DateTime?          @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt   DateTime?          @map("submitted_at") @db.Timestamptz(6)
  gradedAt      DateTime?          @map("graded_at") @db.Timestamptz(6)
  gradedBy      String?            @map("graded_by")
  answers       AssignmentAnswer[]
  assignment    ClassAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student       User               @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assignmentId, studentId])
  @@index([assignmentId], map: "idx_assignment_submissions_assignment_id")
  @@index([studentId], map: "idx_assignment_submissions_student_id")
  @@map("assignment_submissions")
  @@schema("public")
}

model AssignmentAnswer {
  id           String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  submissionId String               @map("submission_id")
  questionId   String               @map("question_id")
  userAnswer   String?              @map("user_answer")
  is_correct   Boolean?
  timeTaken    Int?                 @map("time_taken")
  question     AssignmentQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([submissionId, questionId])
  @@index([submissionId], map: "idx_assignment_answers_submission_id")
  @@map("assignment_answers")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model public_QuestionHistory {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id       String
  question_id   String
  answered_at   DateTime? @default(now()) @db.Timestamptz(6)
  correct       Boolean
  time_spent    Int?      @default(0)
  difficulty    String?   @default("mixed")
  subject       String?   @default("maths")
  type          String?   @default("calculation")
  elo_at_moment Int
  users         User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([answered_at], map: "idx_question_history_answered_at")
  @@index([user_id], map: "idx_question_history_user_id")
  @@index([user_id, question_id], map: "idx_question_history_user_question")
  @@map("QuestionHistory")
  @@schema("public")
}

model CliApiKey {
  id          String   @id @default(cuid())
  userId      String
  keyHash     String   @unique
  label       String?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cli_api_keys")
  @@schema("public")
}
